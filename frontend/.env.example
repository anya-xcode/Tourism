VITE_API_URL=http://localhost:5001/api

# Optional — without it the Map page plots places by their coordinates instead
VITE_GOOGLE_MAPS_API_KEY=

# Optional — without it the sign-in pages show email/password only
VITE_GOOGLE_CLIENT_ID=

# Never put the Google client secret in the frontend: every VITE_ variable is
# bundled into the JavaScript that browsers download.
